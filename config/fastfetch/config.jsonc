// ==========================================================
// fastfetch - tema Amatista
// Ubicacion: ~/.config/fastfetch/config.jsonc (logo en gema.png, mismo directorio)
// Uso: fastfetch   (alias "ff" en el zshrc; no se ejecuta al abrir la terminal)
// Probar desde el repo:  fastfetch -c ~/amatista/config/fastfetch/config.jsonc
// Colores en formato ANSI 38;2;R;G;B con la paleta de Tema.qml:
//   acento #b98cff  rosa #ff9ad5  cian #8fd3ff  morado #d0a8ff
//   texto #f3eaff   tenue #a08cc0 verde #9ee6b0 ambar #ffcf85
// ==========================================================
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // Gema del tema como imagen (protocolo gráfico de kitty), la misma de Plymouth.
        // Se regenera con: rsvg-convert -w 360 herramientas/plymouth-svg/logo.svg -o config/fastfetch/gema.png
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/gema.png",
        "width": 22,
        "height": 12,
        "padding": { "top": 1, "left": 2, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;185;140;255",
            "title": "38;2;185;140;255",
            "output": "38;2;243;234;255",
            "separator": "38;2;160;140;192"
        },
        "key": { "width": 14 }
    },
    // Formatos cortos en CPU, GPU, tema e iconos: las líneas largas se partían
    // y el resto caía debajo del logo.
    "modules": [
        { "type": "title", "color": { "user": "38;2;185;140;255", "at": "38;2;160;140;192", "host": "38;2;255;154;213" } },
        { "type": "separator", "string": "─", "outputColor": "38;2;160;140;192" },
        // Sistema
        { "type": "os", "key": "  SO", "keyColor": "38;2;185;140;255" },
        { "type": "kernel", "key": "  Kernel", "keyColor": "38;2;185;140;255" },
        { "type": "wm", "key": "  WM", "keyColor": "38;2;185;140;255" },
        { "type": "shell", "key": "  Shell", "keyColor": "38;2;185;140;255" },
        { "type": "terminal", "key": "  Terminal", "keyColor": "38;2;185;140;255" },
        // Hardware
        { "type": "cpu", "key": "  CPU", "keyColor": "38;2;255;154;213" },
        { "type": "gpu", "key": "󰢮  GPU", "keyColor": "38;2;255;154;213", "format": "{vendor} · {driver} · {type}" },
        { "type": "memory", "key": "󰍛  Memoria", "keyColor": "38;2;255;154;213" },
        { "type": "disk", "key": "󰋊  Disco", "keyColor": "38;2;255;154;213", "folders": "/" },
        // Escritorio
        { "type": "theme", "key": "󰏘  Tema GTK", "keyColor": "38;2;143;211;255", "format": "{theme2}" },
        { "type": "icons", "key": "󰀻  Iconos", "keyColor": "38;2;143;211;255", "format": "{icons2}" },
        { "type": "font", "key": "  Fuente", "keyColor": "38;2;143;211;255" },
        { "type": "cursor", "key": "󰇀  Cursor", "keyColor": "38;2;143;211;255" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
    ]
}
