# Archivo de configuración zsh

# ===============================
# zsh - devstar
# ===============================

# Simbolo principal del prompt
# Doble flecha (Nerd Font U+F101) de la línea de escritura:
# lila si el último comando salió bien, rojo si falló
prompt_symbol=

# ===============================
# Opciones de ZSH
# ===============================

setopt auto_cd              # Cambiar de directorio solo escribiendo el nombre sin necesidad de cd
setopt magicequalsubst      # Habilitar la expansión del nombre de archivo para argumento
setopt nonomatch            # Oculta los mensajes de error si no hay coincidencias
setopt promptsubst          # Habilita la sustitucion de comandos en el prompt
setopt extended_glob        # Habilita patrones de coincidencia extendidos para realizar busquedas mas complejas

# el carácter "/" separa palabras al usar Ctrl + W
WORDCHARS=${WORDCHARS//\/}  # No consideres ciertos caracteres parte de la palabra

# Ocultar el signo '%' al final del prompt
export PROMPT_EOL_MARK=""

# ===============================
# Teclado
# ===============================

bindkey -e                              # Combinaciones de teclas de emacs

# Historial expandido al presionar espacio
bindkey ' ' magic-space                 # Hacer expansión del historial al presionar  espacio

# Navegación por palabras
bindkey '^[[1;5C' forward-word		# ctrl + ->
bindkey '^[[1;5D' backward-word		# ctrl + <-

# Navegacion por caracteres
bindkey '^[[C' forward-char             # ->
bindkey '^[[D' backward-char            # <-

# Ctrl + Delete
bindkey '^[[2;5~' kill-word             # ctrl + Supr

# Ctrl + Tab
bindkey '^[[Z' undo                     # shift + tab deshacer ultima accion

# ==============================
# Alias
# ==============================

# Navegación
alias ..='cd ../'
alias ...='cd ../..'

# Listado (si eza está instalado se redefinen en "Integraciones opcionales")
alias ll='ls -lahF'
alias la='ls -A'

# Git - básicos
alias gs='git status'
alias ga='git add'
alias gaa='git add --all'
alias gc='git commit'
alias gcm='git commit -m'
alias gp='git push'

# Git - ramas
alias gb='git branch'
alias gba='git branch -a'
alias gco='git checkout'
alias gcb='git checkout -b'

# Git - historial
alias glog='git log --oneline --graph --decorate --all'
alias glast='git log -1 --stat'

# Git - diferencias
alias gd='git diff'
alias gds='git diff --staged'

# Git - remoto
alias gr='git remote -v'

# Docker
alias d='docker'
alias dc='docker compose'
alias dps='docker ps'
alias dpa='docker ps -a'
alias di='docker images'
alias dex='docker exec -it'
alias dlog='docker logs'
alias dlf='docker logs -f'
alias dst='docker stop'
alias drm='docker rm'

# Systemd
alias sc='sudo systemctl'
alias scs='sudo systemctl status'
alias scr='sudo systemctl restart'
alias scst='sudo systemctl stop'
alias scstart='sudo systemctl start'
alias sce='sudo systemctl enable'
alias scd='sudo systemctl disable'
alias jctl='sudo journalctl'
alias jctlf='sudo journalctl -f'

# ==============================
# Autocompleado
# ==============================

mkdir -p "$HOME/.cache/zsh"

# compinit es lo más caro del arranque: la auditoría de seguridad (compaudit)
# solo se hace una vez al día; el resto de inicios reutiliza el volcado (-C).
# Si instalas un paquete y no aparece su autocompletado: rm ~/.cache/zsh/zcompdump*
autoload -Uz compinit
_zcd="$HOME/.cache/zsh/zcompdump"
if [[ -n $_zcd(#qN.mh-24) ]]; then
	compinit -C -d "$_zcd"
else
	compinit -d "$_zcd"
	command touch "$_zcd"
fi
# Volcado compilado: carga más rápido
[[ $_zcd.zwc -nt $_zcd ]] || zcompile "$_zcd" 2>/dev/null
unset _zcd

# Menu interactivo
zstyle ':completion:*:*:*:*:*' menu select

# Ignorar mayúsculas/minúsculas
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# Mostrar descripciones
zstyle ':completion:*' verbose yes

# Agrupar resultados por categoría
zstyle ':completion:*' group-name ''

# Colores en las opciones: se definen junto a LS_COLORS (más abajo)

# Selección con las flechas
zstyle ':completion:default' list-prompt '%S%M matches%s'

# No insertar automáticamente una opción ambigua
zstyle ':completion:*' insert-tab pending

# Completar directorios de forma más cómoda
zstyle ':completion:*' squeeze-slashes true

# ==============================
# Historial
# ==============================

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify
setopt hist_find_no_dups
setopt hist_reduce_blanks
setopt inc_append_history

# forzar a zsh para que muestre el historial completo
alias history="history 0"

# ==============================
# Colores del prompt (paleta Amatista)
# ==============================

# Los mismos tonos que Tema.qml / kitty/amatista.conf, en truecolor.
# En terminales sin truecolor (TTY) zsh/nearcolor los aproxima a 256 colores.
[[ $COLORTERM == (truecolor|24bit) ]] || zmodload zsh/nearcolor 2>/dev/null

PROMPT_TEXTO='%F{#f3eaff}'
PROMPT_SUAVE='%F{#d4c2f0}'
PROMPT_TENUE='%F{#a08cc0}'
PROMPT_ACENTO='%F{#b98cff}'
PROMPT_MORADO='%F{#d0a8ff}'
PROMPT_ROSA='%F{#ff9ad5}'
PROMPT_CIAN='%F{#8fd3ff}'
PROMPT_VERDE='%F{#9ee6b0}'
PROMPT_AMBAR='%F{#ffcf85}'
PROMPT_ERROR='%F{#ff7a9a}'
PROMPT_RESET='%f'

# ==============================
# Git (un solo proceso por pintado)
# ==============================

# En cada precmd se ejecuta UNA vez "git status --porcelain=v2 --branch" y se
# deja el resultado en $git_prompt_info (el prompt no lanza subshells).
# Fuera de un repositorio no se lanza ningún proceso: el .git se busca
# subiendo directorios con zsh puro.
#   +  cambios en stage (verde)      !  cambios sin stage (ámbar)
#   ?  archivos sin seguimiento      ✓  repositorio limpio
#   ↑n ↓n  commits por subir / bajar (cian)
#   rebase / merge / cherry-pick en curso (rojo)
autoload -Uz add-zsh-hook

git_prompt_info=""

# Deja en $REPLY el gitdir del repositorio actual (vacío si no hay)
_git_buscar_gitdir() {
	REPLY=""
	local dir=$PWD linea
	while true; do
		if [[ -d $dir/.git ]]; then
			REPLY=$dir/.git
			return 0
		elif [[ -f $dir/.git ]]; then
			# worktrees y submódulos: el .git es un archivo "gitdir: <ruta>"
			read -r linea < "$dir/.git"
			REPLY=${linea#gitdir: }
			[[ $REPLY == /* ]] || REPLY=$dir/$REPLY
			return 0
		fi
		[[ -z $dir || $dir == / ]] && return 1
		dir=${dir:h}
	done
}

actualizar_git_prompt() {
	git_prompt_info=""
	_git_buscar_gitdir || return

	local gitdir=$REPLY linea rama oid
	local -i ahead=0 behind=0 staged=0 unstaged=0 untracked=0

	# Una única llamada; --no-optional-locks evita bloquear el índice
	for linea in ${(f)"$(git --no-optional-locks status --porcelain=v2 --branch 2>/dev/null)"}; do
		case $linea in
			'# branch.head '*) rama=${linea#\# branch.head } ;;
			'# branch.oid '*)  oid=${linea#\# branch.oid } ;;
			'# branch.ab '*)
				local -a ab=(${=linea#\# branch.ab })
				ahead=${ab[1]#+}; behind=${ab[2]#-} ;;
			'? '*) untracked=1 ;;
			[12u]' '*)
				# XY: X = stage, Y = árbol de trabajo ("." = sin cambios)
				[[ ${linea[3]} != . ]] && staged=1
				[[ ${linea[4]} != . ]] && unstaged=1 ;;
		esac
	done
	[[ -z $rama ]] && return   # git falló (repositorio dañado, etc.)

	# HEAD separado: mostrar el commit abreviado
	[[ $rama == '(detached)' ]] && rama=${oid[1,7]}

	local estado=""
	(( staged ))    && estado+="${PROMPT_VERDE}+"
	(( unstaged ))  && estado+="${PROMPT_AMBAR}!"
	(( untracked )) && estado+="${PROMPT_TENUE}?"
	[[ -z $estado ]] && estado="${PROMPT_VERDE}✓"
	(( ahead > 0 ))  && estado+=" ${PROMPT_CIAN}↑${ahead}"
	(( behind > 0 )) && estado+=" ${PROMPT_CIAN}↓${behind}"

	# Operación en curso: solo comprobaciones de archivos, sin procesos
	local accion=""
	if [[ -e $gitdir/rebase-merge || -e $gitdir/rebase-apply ]]; then
		accion=" ${PROMPT_ERROR}rebase"
	elif [[ -e $gitdir/MERGE_HEAD ]]; then
		accion=" ${PROMPT_ERROR}merge"
	elif [[ -e $gitdir/CHERRY_PICK_HEAD ]]; then
		accion=" ${PROMPT_ERROR}cherry-pick"
	fi

	# "%" en el nombre de la rama se escapa para que no se interprete en el prompt
	git_prompt_info=" ${PROMPT_ROSA}${PROMPT_RESET} ${PROMPT_SUAVE}${rama//\%/%%}${accion} ${estado}${PROMPT_RESET}"
}

add-zsh-hook precmd actualizar_git_prompt

# ==============================
# Prompt
# ==============================

# Línea 1:  ~/ruta/abreviada  rama +!? ↑1
# Línea 2: ֍  (acento si el último comando terminó bien, rojo si falló)
#
# Ruta: con 6 o más niveles muestra el primero, "…" y los 4 últimos.
# Gema del tema Amatista (Nerd Font U+F0B8A)
PROMPT="${PROMPT_ACENTO}󰮊${PROMPT_RESET} "
#PROMPT+="%B${PROMPT_TEXTO}%n${PROMPT_RESET}%b "
#PROMPT+="%B${PROMPT_TEXTO}%m${PROMPT_RESET}%b "
# Ruta en cian y negrita: contrasta con el lila del icono y el rosa de git
PROMPT+="%B${PROMPT_CIAN}%(6~.%-1~/…/%4~.%5~)${PROMPT_RESET}%b"
PROMPT+='${git_prompt_info}'
PROMPT+=$'\n'
PROMPT+="%B%(?.${PROMPT_ACENTO}.${PROMPT_ERROR})${prompt_symbol}${PROMPT_RESET}%b "

# Prompt derecho: entorno Python activo y código de salida si falló
RPROMPT='${VIRTUAL_ENV:+${PROMPT_CIAN} ${VIRTUAL_ENV:t}${PROMPT_RESET} }'
RPROMPT+="%(?..${PROMPT_ERROR}✘ %?${PROMPT_RESET})"

# Prompt de continuación (bucles, comillas sin cerrar...)
PROMPT2="${PROMPT_TENUE}%_ ›${PROMPT_RESET} "

# =============================
# Colores de comandos
# =============================

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip --color=auto'

export VIRTUAL_ENV_DISABLE_PROMPT=1

# =============================
# PATH
# =============================

export PATH="/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl"

export PATH="$HOME/.local/bin:$PATH"

typeset -U path PATH

# =============================
# mise
# =============================

eval "$(mise activate zsh)"
export PATH="/usr/lib/qt6/bin:$PATH"

# =============================
# Colores de archivos (LS_COLORS)
# =============================

# Definido a mano (sin lanzar dircolors) con los ANSI del tema kitty:
#   35 = acento #b98cff (directorios)   32 = verde #9ee6b0 (ejecutables)
#   36 = cian #8fd3ff (enlaces)         31 = error #ff7a9a (enlaces rotos)
#   33 = ambar #ffcf85 (comprimidos, dispositivos)  95 = morado (multimedia)
# Lo usan ls, eza y el menú de autocompletado (list-colors).
LS_COLORS='rs=0:di=1;35:ln=36:mh=36:pi=33:so=33:do=33:bd=1;33:cd=1;33:or=31:mi=31:su=1;31:sg=1;31:ca=1;31:tw=1;35;40:ow=1;35:st=1;35:ex=1;32'
LS_COLORS+=':*.tar=33:*.gz=33:*.tgz=33:*.xz=33:*.zst=33:*.bz2=33:*.zip=33:*.7z=33:*.rar=33:*.deb=33:*.rpm=33:*.pkg.tar.zst=33'
LS_COLORS+=':*.png=95:*.jpg=95:*.jpeg=95:*.gif=95:*.webp=95:*.svg=95:*.mp4=95:*.mkv=95:*.webm=95:*.mp3=95:*.flac=95:*.ogg=95:*.wav=95'
LS_COLORS+=':*~=90:*.bak=90:*.swp=90:*.tmp=90'
export LS_COLORS
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# =============================
# Integraciones opcionales
# =============================

# Cada herramienta solo se carga si está instalada. Para no lanzar procesos en
# cada inicio, la salida de "<herramienta> init" se guarda en ~/.cache/zsh/ y
# solo se regenera cuando el binario es más nuevo que la caché (actualización).
#   _cargar_cache <nombre-cache> <binario> <orden completa...>
_cargar_cache() {
	local nombre=$1 binario=$commands[$2]
	local cache="$HOME/.cache/zsh/$nombre.zsh"
	shift 2
	if [[ ! -s $cache || $binario -nt $cache ]]; then
		if "$@" >| "$cache.tmp" 2>/dev/null && [[ -s $cache.tmp ]]; then
			command mv -f "$cache.tmp" "$cache"
			zcompile "$cache" 2>/dev/null
		else
			command rm -f "$cache.tmp"
			return 1
		fi
	fi
	source "$cache"
}

# ----- fzf: Ctrl+R historial, Ctrl+T archivos, Alt+C directorios -----
if (( $+commands[fzf] )); then
	export FZF_DEFAULT_OPTS="\
--height=40% --layout=reverse --border=rounded --info=inline-right \
--prompt='${prompt_symbol} ' --pointer='▶' --marker='✓' --separator='─' \
--color=bg:-1,bg+:#52406f,gutter:-1 \
--color=fg:#d4c2f0,fg+:#f3eaff,hl:#ff9ad5,hl+:#ff9ad5 \
--color=info:#a08cc0,prompt:#b98cff,pointer:#ff9ad5,marker:#9ee6b0,spinner:#d0a8ff \
--color=header:#8fd3ff,border:#52406f,label:#b98cff,query:#f3eaff,separator:#52406f,scrollbar:#6b5a8a"

	# fd es más rápido que find y respeta .gitignore (opcional)
	if (( $+commands[fd] )); then
		export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
		export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
		export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
	fi

	# Vistas previas (solo si las herramientas existen)
	(( $+commands[bat] )) && export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
	(( $+commands[eza] )) && export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --icons=always --color=always {}'"

	# fzf >= 0.48 genera sus atajos con "fzf --zsh"; si no, scripts del paquete
	if ! _cargar_cache fzf fzf fzf --zsh; then
		[[ -r /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh
		[[ -r /usr/share/fzf/completion.zsh ]] && source /usr/share/fzf/completion.zsh
	fi
fi

# ----- eza: ls moderno con iconos Nerd Font -----
if (( $+commands[eza] )); then
	# Colores propios de eza (el resto los toma de LS_COLORS):
	# permisos, tamaños, usuario, fechas, git y la puntuación en tonos del tema
	export EZA_COLORS='ur=33:uw=31:ux=32:ue=32:gr=33:gw=31:gx=32:tr=33:tw=31:tx=32:su=1;31:sf=1;31:xa=36'
	EZA_COLORS+=':sn=35:sb=90:uu=37:uR=1;31:un=90:gu=37:gR=1;31:gn=90:da=90:hd=4;37:lp=36'
	EZA_COLORS+=':ga=32:gm=33:gd=31:gv=36:gt=35:gi=90:gc=1;31:xx=90'

	alias ls='eza --icons=auto --color=auto --group-directories-first'
	alias ll='eza -lah --icons=auto --color=auto --group-directories-first --git --time-style=relative'
	alias la='eza -a --icons=auto --color=auto --group-directories-first'
	alias lt='eza --tree --level=2 --icons=auto --color=auto --group-directories-first --git-ignore'
fi

# ----- zoxide: z <parte-del-nombre> salta a directorios frecuentes, zi interactivo -----
# Debe cargarse después de compinit (para el autocompletado de z)
(( $+commands[zoxide] )) && _cargar_cache zoxide zoxide zoxide init zsh

unfunction _cargar_cache

