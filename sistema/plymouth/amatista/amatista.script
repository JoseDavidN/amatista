# ---------------------------------------------------------------------------
#  Tema Plymouth "Amatista"
#  Fondo liso #1e1530, gema centrada, tres puntos que laten en #b98cff,
#  diálogo de contraseña para discos cifrados y mensajes del sistema.
#  Los PNG están dibujados al doble de tamaño de 1080p y se escalan aquí.
# ---------------------------------------------------------------------------

# --- Paleta (valores 0..1) ---------------------------------------------------
# En decimal: el lenguaje de Plymouth no acepta números hexadecimales (0x..).
fondo.r = 30 / 255; fondo.g = 21 / 255; fondo.b = 48 / 255;
texto.r = 243 / 255; texto.g = 234 / 255; texto.b = 255 / 255;
suave.r = 212 / 255; suave.g = 194 / 255; suave.b = 240 / 255;
tenue.r = 160 / 255; tenue.g = 140 / 255; tenue.b = 192 / 255;
fallo.r = 255 / 255; fallo.g = 122 / 255; fallo.b = 154 / 255;

Window.SetBackgroundTopColor(fondo.r, fondo.g, fondo.b);
Window.SetBackgroundBottomColor(fondo.r, fondo.g, fondo.b);

# --- Geometría ---------------------------------------------------------------
ancho = Window.GetWidth();
alto = Window.GetHeight();
origen_x = Window.GetX();
origen_y = Window.GetY();

escala = alto / 1080;
if (escala < 0.5) escala = 0.5;
if (escala > 2) escala = 2;

tam_letra = Math.Int(12 * escala);
if (tam_letra < 10) tam_letra = 10;
fuente = "Noto Sans " + tam_letra;
fuente_titulo = "Noto Sans Bold " + Math.Int(tam_letra * 1.25);

# Carga una imagen y la escala (los PNG están a 2x).
fun cargar(nombre) {
    local.img = Image(nombre);
    return img.Scale(Math.Int(img.GetWidth() * escala / 2),
                     Math.Int(img.GetHeight() * escala / 2));
}

# Crea un texto con un color de la paleta.
fun rotulo(cadena, color, letra) {
    return Image.Text(cadena, color.r, color.g, color.b, 1, letra);
}

centro_x = origen_x + ancho / 2;

# --- Logo --------------------------------------------------------------------
logo.imagen = cargar("logo.png");
logo.sprite = Sprite(logo.imagen);
logo.x = centro_x - logo.imagen.GetWidth() / 2;
logo.y = origen_y + alto * 0.42 - logo.imagen.GetHeight() / 2;
logo.sprite.SetPosition(logo.x, logo.y, 10);
logo.sprite.SetOpacity(0);

# --- Puntos de carga ---------------------------------------------------------
punto_img = cargar("punto.png");
separacion = 26 * escala;
puntos_y = logo.y + logo.imagen.GetHeight() + 28 * escala;
for (i = 0; i < 3; i++) {
    puntos[i] = Sprite(punto_img);
    puntos[i].SetPosition(centro_x + (i - 1) * separacion - punto_img.GetWidth() / 2,
                          puntos_y, 10);
    puntos[i].SetOpacity(0.3);
}

# --- Rótulo de modo (apagado, reinicio, actualización) -----------------------
modo = Plymouth.GetMode();
modo_texto = "";
if (modo == "shutdown") modo_texto = "Apagando…";
if (modo == "reboot") modo_texto = "Reiniciando…";
if (modo == "updates" || modo == "system-upgrade") modo_texto = "Instalando actualizaciones, no apagues el equipo";
if (modo == "firmware-upgrade") modo_texto = "Actualizando el firmware, no apagues el equipo";

modo_sprite = Sprite();
if (modo_texto != "") {
    modo_img = rotulo(modo_texto, suave, fuente);
    modo_sprite.SetImage(modo_img);
    modo_sprite.SetPosition(centro_x - modo_img.GetWidth() / 2,
                            puntos_y + 40 * escala, 10);
}

# --- Diálogo de contraseña ---------------------------------------------------
caja_img = cargar("caja.png");
campo_img = cargar("campo.png");
candado_img = cargar("candado.png");
vineta_img = cargar("vineta.png");

dialogo.x = centro_x - caja_img.GetWidth() / 2;
# La tarjeta queda justo debajo de la gema (los puntos se ocultan).
dialogo.y = logo.y + logo.imagen.GetHeight() - 10 * escala;
dialogo.visible = 0;

dialogo.caja = Sprite(caja_img);
dialogo.caja.SetPosition(dialogo.x, dialogo.y, 20);
dialogo.candado = Sprite(candado_img);
dialogo.candado.SetPosition(centro_x - candado_img.GetWidth() / 2, dialogo.y + 22 * escala, 21);
dialogo.titulo = Sprite();
dialogo.titulo.SetZ(21);
dialogo.campo = Sprite(campo_img);
dialogo.campo_x = centro_x - campo_img.GetWidth() / 2;
dialogo.campo_y = dialogo.y + 104 * escala;
dialogo.campo.SetPosition(dialogo.campo_x, dialogo.campo_y, 21);
dialogo.pista = Sprite(rotulo("Pulsa Intro para continuar", tenue, fuente));
dialogo.pista.SetPosition(centro_x - dialogo.pista.GetImage().GetWidth() / 2,
                          dialogo.campo_y + campo_img.GetHeight() + 14 * escala, 21);

maximo_vinetas = 20;
paso_vineta = 16 * escala;
for (i = 0; i < maximo_vinetas; i++) {
    vinetas[i] = Sprite(vineta_img);
    vinetas[i].SetZ(22);
    vinetas[i].SetOpacity(0);
}

fun mostrar_dialogo(opacidad) {
    dialogo.caja.SetOpacity(opacidad);
    dialogo.candado.SetOpacity(opacidad);
    dialogo.titulo.SetOpacity(opacidad);
    dialogo.campo.SetOpacity(opacidad);
    dialogo.pista.SetOpacity(opacidad);
    if (opacidad == 0) {
        for (i = 0; i < maximo_vinetas; i++) vinetas[i].SetOpacity(0);
    }
    dialogo.visible = opacidad;
}
mostrar_dialogo(0);

# Coloca las viñetas centradas dentro del campo.
fun dibujar_vinetas(cantidad) {
    local.n = cantidad;
    if (n > maximo_vinetas) n = maximo_vinetas;
    local.total = (n - 1) * paso_vineta;
    local.inicio = centro_x - total / 2;
    local.y = dialogo.campo_y + (campo_img.GetHeight() - vineta_img.GetHeight()) / 2;
    for (i = 0; i < maximo_vinetas; i++) {
        if (i < n) {
            vinetas[i].SetPosition(inicio + i * paso_vineta - vineta_img.GetWidth() / 2, y, 22);
            vinetas[i].SetOpacity(1);
        } else {
            vinetas[i].SetOpacity(0);
        }
    }
}

fun poner_titulo(cadena) {
    if (!cadena || cadena == "") cadena = "Introduce la contraseña del disco";
    local.img = rotulo(cadena, texto, fuente_titulo);
    # Si el mensaje del sistema es demasiado largo se usa uno propio.
    if (img.GetWidth() > caja_img.GetWidth() - 40 * escala) {
        img = rotulo("Introduce la contraseña del disco", texto, fuente_titulo);
    }
    dialogo.titulo.SetImage(img);
    dialogo.titulo.SetPosition(centro_x - img.GetWidth() / 2, dialogo.y + 66 * escala, 21);
}

fun al_pedir_contrasena(mensaje, cantidad) {
    poner_titulo(mensaje);
    mostrar_dialogo(1);
    dibujar_vinetas(cantidad);
}
Plymouth.SetDisplayPasswordFunction(al_pedir_contrasena);

# Preguntas con texto visible (poco habituales): se muestra lo escrito.
fun al_preguntar(mensaje, respuesta) {
    poner_titulo(mensaje);
    mostrar_dialogo(1);
    dibujar_vinetas(0);
    local.img = rotulo(respuesta, texto, fuente);
    vinetas[0].SetImage(img);
    vinetas[0].SetPosition(centro_x - img.GetWidth() / 2,
                           dialogo.campo_y + (campo_img.GetHeight() - img.GetHeight()) / 2, 22);
    vinetas[0].SetOpacity(1);
}
Plymouth.SetDisplayQuestionFunction(al_preguntar);

fun al_volver_normal() {
    mostrar_dialogo(0);
    vinetas[0].SetImage(vineta_img);
}
Plymouth.SetDisplayNormalFunction(al_volver_normal);

# --- Mensajes del sistema ----------------------------------------------------
mensaje_sprite = Sprite();
mensaje_sprite.SetZ(30);

fun al_recibir_mensaje(cadena) {
    local.color = tenue;
    # Los fallos de systemd/cryptsetup se resaltan en el color de error.
    if (cadena.SubString(0, 5) == "Error" || cadena.SubString(0, 6) == "Failed") color = fallo;
    local.img = rotulo(cadena, color, fuente);
    mensaje_sprite.SetImage(img);
    mensaje_sprite.SetPosition(centro_x - img.GetWidth() / 2,
                               origen_y + alto - img.GetHeight() - 48 * escala, 30);
    mensaje_sprite.SetOpacity(1);
}
Plymouth.SetDisplayMessageFunction(al_recibir_mensaje);

fun al_ocultar_mensaje(cadena) {
    mensaje_sprite.SetOpacity(0);
}
Plymouth.SetHideMessageFunction(al_ocultar_mensaje);

# --- Animación ---------------------------------------------------------------
# Plymouth llama a esta función unas 50 veces por segundo.
tiempo = 0;
fun al_refrescar() {
    tiempo++;
    # Aparición rápida del logo (0,3 s): el arranque dura pocos segundos y
    # el monitor HDMI tarda en mostrar imagen tras el cambio de modo.
    local.alfa = tiempo / 15;
    if (alfa > 1) alfa = 1;
    logo.sprite.SetOpacity(alfa);

    # Los puntos laten en cadena; se ocultan mientras se pide la contraseña.
    for (i = 0; i < 3; i++) {
        if (dialogo.visible) {
            puntos[i].SetOpacity(0);
        } else {
            local.fase = tiempo / 14 - i * 0.9;
            puntos[i].SetOpacity(alfa * (0.25 + 0.75 * (0.5 + 0.5 * Math.Sin(fase))));
        }
    }
    modo_sprite.SetOpacity(alfa * (1 - dialogo.visible));
}
Plymouth.SetRefreshFunction(al_refrescar);

fun al_salir() {
    mostrar_dialogo(0);
    for (i = 0; i < 3; i++) puntos[i].SetOpacity(0);
}
Plymouth.SetQuitFunction(al_salir);
