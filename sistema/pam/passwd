#%PAM-1.0
# PAM de passwd (se instala en /etc/pam.d/passwd).
# Es el archivo original de Arch más gnome-keyring: al cambiar tu contraseña
# con "passwd" dentro de la sesión, también cambia la del llavero "login",
# así sigue desbloqueándose solo al iniciar sesión.

auth      include   system-auth
account   include   system-auth
password  include   system-auth
password  optional  pam_gnome_keyring.so
